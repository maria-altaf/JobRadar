# Copy to .env for local development. Never commit the real .env --
# DATABASE_URL contains credentials.

# Local development uses a SQLite file; production uses Postgres.
# Postgres example:
#   DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=sqlite:///data/jobradar.db

# Sent on every outbound request. Identify the project and give site operators
# a way to reach a human -- this scraper runs unattended every day.
JOBRADAR_USER_AGENT=jobradar/1.0 (personal job-market data pipeline; contact: you@example.com)

# --- scope -------------------------------------------------------------------
# JOBRADAR_SOURCES=hackernews,weworkremotely,remoteok
# How many monthly "Who is hiring?" threads to read. Each costs 30s of
# wall-clock because Hacker News publishes Crawl-delay: 30.
# JOBRADAR_HN_THREADS=2
# JOBRADAR_WWR_CATEGORIES=remote-programming-jobs,remote-devops-sysadmin-jobs
# JOBRADAR_REMOTEOK_TAGS=dev,engineer,design,marketing

# --- networking --------------------------------------------------------------
# JOBRADAR_MAX_CONCURRENCY=8
# JOBRADAR_HTTP_TIMEOUT=30
# JOBRADAR_MAX_ATTEMPTS=5
# JOBRADAR_BACKOFF_BASE=1.0
# JOBRADAR_BACKOFF_CAP=60.0
# Set to false ONLY for local tests against mocked hosts.
# JOBRADAR_RESPECT_ROBOTS=true

# --- health thresholds -------------------------------------------------------
# Fail the run if more than this share of records fail validation.
# JOBRADAR_MAX_QUARANTINE_RATE=0.25
# Fail the run if a source drops below this fraction of its trailing median.
# JOBRADAR_PARSER_HEALTH_RATIO=0.2
# The dashboard shows red past this many hours without a successful run.
# JOBRADAR_STALE_AFTER_HOURS=30

# JOBRADAR_LOG_LEVEL=INFO
